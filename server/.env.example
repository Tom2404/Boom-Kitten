PORT=5000
# Prod: mongodb+srv://... (Atlas is already a replica set).
# Local: mongodb://127.0.0.1:27017/boomkitten?replicaSet=rs0 and run rs.initiate() once —
# tournament registration uses transactions, which standalone MongoDB rejects.
MONGO_URI=mongodb+srv://...
# Turns on the tournament API surface and the lifecycle scheduler (auto start/cancel/forfeit).
TOURNAMENTS_ENABLED=true
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:2404
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Boom-Kitten <no-reply@example.com>
